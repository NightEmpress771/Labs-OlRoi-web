generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  role      Role      @default(USER)
  bookings  Booking[]
  reviews   Review[]
}

enum Role {
  USER
  ADMIN
}

model Vehicle {
  id          Int       @id @default(autoincrement())
  type        VehicleType
  model       String
  status      Status    @default(AVAILABLE)
  bookings    Booking[]
  reviews     Review[]
}

enum VehicleType {
  BIKE
  SCOOTER
}

enum Status {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model Booking {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id])
  userId    Int
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  vehicleId Int
  startTime DateTime      @default(now())
  endTime   DateTime?
  status    BookingStatus @default(ACTIVE)
}

enum BookingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId Int
}