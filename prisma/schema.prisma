generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(USER)
  balance       Float          @default(100)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  files         File[]
  refreshTokens RefreshToken[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]
}

model Vehicle {
  id           Int       @id @default(autoincrement())
  type         String    // 'BIKE' або 'SCOOTER'
  model        String
  description  String?
  pricePerHour Float     @default(50)
  imageUrl     String?
  status       String    @default("AVAILABLE") // 'AVAILABLE', 'IN_USE', 'MAINTENANCE'
  bookings     Booking[]
  reviews      Review[]

  @@index([type, status])
}

model Booking {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId  Int
  hours      Int       @default(1)
  totalPrice Float     @default(0)
  startTime  DateTime  @default(now())
  endTime    DateTime?
  status     String    @default("ACTIVE") // 'ACTIVE', 'COMPLETED', 'CANCELLED'

  @@index([userId])
  @@index([vehicleId])
}

model Review {
  id        Int     @id @default(autoincrement())
  rating    Int
  comment   String?
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId Int

  @@index([vehicleId])
}

model File {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String
  mimetype     String
  size         Int
  path         String
  uploadedBy   Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// НОВА ТАБЛИЦЯ ДЛЯ 3-Ї ЛАБИ: Сповіщення в реальному часі
model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  isRead    Boolean  @default(false)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}